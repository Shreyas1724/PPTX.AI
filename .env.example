POSTGRES_PASSWORD=replace_for_any_public_deployment
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
GENERATION_COST=2

# Browser authentication: use true with HTTPS in production.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_SECRET=
GOOGLE_CLIENT_ID=
# SMTP (Gmail app password or a transactional email provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Twilio SMS sender with permission to deliver in target countries
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# v3 — set production only after HTTPS and PostgreSQL are configured
APP_ENV=development
AI_EDIT_COST=1
# Optional credit purchases; amount is in the currency's smallest unit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000
CREDIT_PACK_AMOUNT=0
CREDIT_PACK_CREDITS=100
BILLING_CURRENCY=inr

# Projects Studio: 0 credits by default, set an approved price to charge for AI analyses.
PROJECT_ANALYSIS_COST=0
# Optional source-linked public research. Without it, search is marked not configured.
PROJECT_RESEARCH_BRAVE_API_KEY=

# Presentation quality engine: static geometry QA is always enabled.
# Optional independent LibreOffice PDF export validation in the background worker.
# Enabling adds an office-renderer dependency and increases worker image size.
PPTX_VISUAL_QA=0
PPTX_INSTALL_RENDERING_QA=0
